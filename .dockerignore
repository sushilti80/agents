# Docker ignore file for Platform Architect Agent
# Prevents unnecessary files from being copied to Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Virtual Environment
bin/
lib/
lib64/
include/
pyvenv.cfg
share/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
agent.log

# Chainlit
.chainlit/chroma.sqlite3
.chainlit/.langchain.db

# Documentation
*.md
!chainlit.md
README.md
CHANGELOG.md
docs/
TOOLS_CONFIGURATION.md
DEEPWIKI_VERIFICATION.md
IMPLEMENTATION_SUMMARY.md
SEQUENTIAL_THINKING.md

# Git
.git/
.gitignore
.gitattributes

# Testing
test/
tests/
*.test.py
pytest.ini

# Backup files
*.bak
*.backup
*.old

# Temporary files
tmp/
temp/
*.tmp

# Node modules (will be installed in Docker)
node_modules/

# Package manager files
package-lock.json
yarn.lock
poetry.lock
Pipfile.lock
